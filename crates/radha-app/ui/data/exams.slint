// ============================================================================
// Exam catalogue — the data behind the Home "Exam Hub"
// ============================================================================
//
// Presentation only. Exam rules live in the `radha-exams` crate as data-driven
// ExamProfiles (RULES.MD Rule 31, crates/radha-exams/profiles/*.toml; one profile
// per card, same id). At startup Rust rewrites each card's `eng-speed`,
// `hin-speed`, `rule` and `level` from its profile (`ui::apply_exam_profiles`);
// the literals below are the fallback and are kept equal to the derived values
// by a test (tests/exam_mode_p09.rs).
//
// Honesty rules applied here (RULES.MD Rule 32):
//
//   * A rule value appears on a card ONLY if it comes from a notification or from
//     Golu's own statement of a verified rule. Everything else is "—".
//   * The speeds shown in the reference mock-up (design-reference/01-home.html) for
//     SSC, RRB, UPSSSC, CPCT, RSSB, Delhi Police, AIIMS, DSSSB, UP Police, CRPF,
//     CAPF, UPPCL and the High Courts are UNVERIFIED claims and are deliberately
//     NOT displayed. They are `reference_claims` in each profile, always
//     unverified and never applied as rules.
//   * `level` is the certification level the card advertises:
//       "official"    all required fields verified          (none yet)
//       "provisional" thresholds known, other fields not    (Patna HC, BELTRON)
//       "practice"    thresholds unknown, no pass/fail
//
// Sources:
//   Patna HC COT 2026  - High Court advertisement, Annexure-I (EXAM-MODE plan S-03)
//   BELTRON DEO        - rules stated by Golu; primary document still pending (X-03)
//   Bihar Civil Court  - no typing-test rule found for Employment Notice 01/2022
//   BSSC Inter-Level   - advertisement-by-advertisement; primary PDFs pending (X-04)
//
// The `category` values drive the Exam Hub filter: "central", "state", "court".
// `accent` is a token name resolved by `Accents` in products.slint.
// ============================================================================

export struct ExamEntry {
    /// Stable id, used for launch callbacks and (later) the profile registry key.
    id: string,
    /// 2-5 letter seal text.
    crest: string,
    /// Department / cadre line shown above the title.
    dept: string,
    /// Short qualifier chip text.
    tag: string,
    title: string,
    org: string,
    description: string,
    /// "—" when not verified.
    eng-speed: string,
    hin-speed: string,
    font-layout: string,
    /// One-line summary of the test rule, or why none is shown.
    rule: string,
    /// "central" | "state" | "court"
    category: string,
    /// Accent token name.
    accent: string,
    /// "official" | "provisional" | "practice"
    level: string,
    /// Hindi only (no English launcher); typed on the Mangal Unicode
    /// layouts InScript, Remington GAIL and Remington CBI. Entries that omit
    /// it are bilingual.
    hindi-only: bool,
}

export global Exams {
    out property <[ExamEntry]> all: [
        // ---- All-in-One Mangal (first card, P09 A7) ------------------------
