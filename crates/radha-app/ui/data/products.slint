// ============================================================================
// Product catalogue — the data behind the Home screen
// ============================================================================
//
// The nine Home products as data rather than nine hand-written card blocks. The
// Home screen renders these with a `for` loop, so a card's layout is defined once.
//
// Why the data lives here and not in Rust
// ---------------------------------------
// Two things are deliberately split:
//
//   * Product *identity* is owned by Rust (`radha_content::ProductId`). It is the
//     canonical list, it backs navigation, and it will back the SQLite `product`
//     column. The `slug` field below is exactly that identifier.
//   * Product *presentation* — copy, accent, badges, CTA wording — lives here,
//     because it is UI content and belongs with the UI.
//
// The slugs are the contract between the two. Rust parses whatever slug a card
// emits (`ProductId::from_slug`) and rejects anything it does not recognise, so a
// typo here surfaces as a logged warning rather than a broken card.
//
// Accents are named tokens, not colours: `Accents` below maps a name to a `Theme`
// value. That keeps every colour decision inside the theme layer, so no raw hex
// can leak into product data.
//
// v2 (PRD Chapter 17, DESIGN Chapter 20)
// --------------------------------------
// Each card now carries a "signature" — a row of key caps that makes the three
// cards in a section look distinct while sharing one structure:
//   deck-label   small caps title above the keys
//   deck-keys    the caps themselves ("·" and "→" render as separators)
//   deck-note    right-aligned note on the same line
// The lists are `in-out` because Rust rewrites them when the search box changes
// (see `src/catalog.rs`); the literals below are the unfiltered masters.
//
// The `meta-1` counts below are the planned content budget (STRUCTURE.MD). At
// startup Rust rewrites each with the number actually installed
// (`catalog::count_chip`), so a product with no content says "coming soon".
// ============================================================================

import { Theme } from "../theme/palette.slint";

/// One Home product card's content.
export struct ProductEntry {
    /// Stable id, matching `radha_content::ProductId::slug`.
    slug: string,
    /// Small caps line above the title ("TRACK 02 · RHYTHM ENGINE"). Empty to omit.
    eyebrow: string,
    /// Product name.
    title: string,
    /// Tagline shown under the title.
    subtitle: string,
    /// One or two lines expanding on what the product does.
    description: string,
    /// Optional qualifier chip, e.g. "Classic". Empty to omit.
    badge: string,
    /// Optional layout identity chip, e.g. "GAIL". Empty to omit.
    identity-label: string,
    /// Accent token name: "primary", "accent", "secondary" or "success".
    accent: string,
    /// Accent token for the identity dot, same vocabulary as `accent`.
    identity-accent: string,
    /// Optional monospaced key sequence, e.g. "[W H S]". Empty to omit.
    key-sequence: string,
    /// Signature block (v2): label, key caps and a right-hand note. Empty keys omit it.
    deck-label: string,
    deck-keys: [string],
    deck-note: string,
    /// Up to three short metadata chips. Empty strings are skipped.
    meta-1: string,
    meta-2: string,
    meta-3: string,
    /// Call to action wording.
    cta: string,
}

/// Maps accent token names to theme colours.
///
/// A name rather than a colour so product data never contains a hex value, and so
/// both themes resolve correctly without the data knowing which is active.
export global Accents {
    pure public function resolve(token: string) -> color {
        if (token == "accent") {
            return Theme.accent;
        }
        if (token == "secondary") {
            return Theme.secondary;
        }
        if (token == "success") {
            return Theme.success;
        }
        return Theme.primary;
    }
}

export global Products {
    /// Typing Flow card: the last real smoothness ("94%"), or "—" when no
    /// Flow session is recorded yet. Written by Rust from the database;
    /// never a made-up figure.
    in-out property <string> flow-smoothness: "—";

    // --- Section 1: English Typing Mastery --------------------------------
    // Classic and Number+Punctuation share the family accent (`primary`).
    // Typing Flow is marked a dedicated experience in DESIGN.md Section 5.1, so it
    // carries a distinct accent even on Home.
    in-out property <[ProductEntry]> english: [
        {
            slug: "english-classic",
            title: "English Typing Mastery",
            subtitle: "Track 01 · Classic",
            description: "Complete QWERTY curriculum, from home-row muscle memory to editorial passages.",
            badge: "Classic",
            accent: "primary",
            deck-label: "HOME ROW ANCHOR",
            deck-keys: ["A", "S", "D", "F", "·", "J", "K", "L", ";"],
            deck-note: "Finger posture guide",
            // Metadata is kept to two short chips. The row does not wrap, so long
            // chips drive the card's minimum width up and push the three-card row
            // past the 1024px minimum window size.
            meta-1: "200 Exercises",
            meta-2: "Learn + Test",
            cta: "Start Practice",
        },
        {
            slug: "typing-flow",
            eyebrow: "TRACK 02 · RHYTHM ENGINE",
            title: "Typing Flow",
            badge: "Adaptive AI",
            description: "Smooth, zero-hesitation word-stream training designed to lock in a steady metronome keystroke cadence.",
            accent: "accent",
            deck-label: "CADENCE STREAM",
            deck-keys: ["the", "·", "quick", "·", "brown", "·", "fox"],
            // The smoothness preview is live data (Products.flow-smoothness),
            // drawn by ProductGrid; "—" until a Flow session is recorded.
            deck-note: "",
            meta-1: "100 Exercises",
            meta-2: "Weak-Key Targeted",
            cta: "Start Flow",
        },
        {
            slug: "number-punctuation",
            title: "Number + Punctuation",
            subtitle: "Track 03 · Alphanumeric",
            description: "Drills for the number row, calculations, brackets and special characters.",
            accent: "secondary",
            deck-label: "TOP-ROW MATRIX",
            deck-keys: ["1", "2", "3", "₹", "%", "&", "(", ")"],
            deck-note: "Numbers + symbols",
            meta-1: "50 Drills",
            meta-2: "Timed",
            cta: "Start Practice",
        },
    ];

    // --- Section 2: Hindi Typing Mastery ----------------------------------
    // All three share ONE accent (`secondary`) for the section header and CTA per
    // DESIGN.md Section 9.3. The card's own top bar and identity chip carry the
    // unique identity accent (decision DV-02).
    //
    // The caps show Devanagari characters as a visual sampler of the layout. They
    // are NOT a statement of key positions — those live in `radha-layouts`.
    in-out property <[ProductEntry]> hindi-mastery: [
        {
            slug: "hindi-mastery-gail",
            title: "Remington GAIL Typing",
            subtitle: "Mangal Unicode · GAIL",
            description: "Remington GAIL layout practice with full guide support.",
            identity-label: "GAIL",
            identity-accent: "success",
            accent: "success",
            deck-label: "DEVANAGARI UNICODE",
            deck-keys: ["क", "ि", "ह", "ी", "श", "स", "य"],
            deck-note: "Matra guide",
            meta-1: "200 Exercises",
            meta-2: "Learn + Test",
            cta: "Start Practice",
        },
        {
            slug: "hindi-mastery-cbi",
            title: "Remington CBI Typing",
            subtitle: "Mangal Unicode · CBI",
            description: "An independent CBI key-mapping profile, not a variant of GAIL.",
            identity-label: "CBI",
            identity-accent: "accent",
            accent: "accent",
            deck-label: "CBI KEYBOARD PROFILE",
            deck-keys: ["म", "त", "ज", "ल", "न", "प", "व"],
            deck-note: "Live error telemetry",
            meta-1: "200 Exercises",
            meta-2: "Learn + Test",
            cta: "Start Practice",
        },
        {
            slug: "hindi-mastery-krutidev",
            title: "Kruti Dev Typing",
            subtitle: "Legacy font · Kruti Dev 010",
            description: "Kruti Dev practice with font-accurate output.",
            identity-label: "Kruti Dev",
            identity-accent: "primary",
            accent: "primary",
            // d -> क and f -> ि are confirmed in Expert AI docs/krutidev-character-audit.md.
            // The mock-up's "Alt+0216 -> क्र" claim was not found there, so it is not shown.
            deck-label: "KEY TO CHARACTER",
            deck-keys: ["d", "→", "क", "·", "f", "→", "ि"],
            deck-note: "Legacy encoding",
            meta-1: "200 Exercises",
            meta-2: "Learn + Test",
            cta: "Start Practice",
        },
    ];

    // --- Section 3: Hindi Learn (Beginner) --------------------------------
    // Three dedicated beginner experiences, so three distinct accents. Key
    // sequences are from PRD.md Section 6.4. Each layout has Beginner 100 and
    // Classic 100 exercises behind the BEGINNER | CLASSIC toggle.
    in-out property <[ProductEntry]> hindi-learn: [
        {
            slug: "hindi-learn-gail",
            title: "Remington GAIL",
            subtitle: "Start from basics",
            description: "Learn the GAIL keyboard one key at a time.",
            badge: "Beginner",
            accent: "success",
            key-sequence: "C V C V M H A V N C P N",
            meta-1: "12 Steps",
            meta-2: "Beginner + Classic",
            cta: "Start Learning",
        },
        {
            slug: "hindi-learn-cbi",
            title: "Remington CBI",
            subtitle: "Start from basics",
            description: "A short introduction to the CBI keyboard.",
            badge: "Beginner",
            accent: "accent",
            key-sequence: "W H S",
            meta-1: "3 Steps",
            meta-2: "Beginner + Classic",
            cta: "Start Learning",
        },
        {
            slug: "hindi-learn-krutidev",
            title: "Kruti Dev",
            subtitle: "Start from basics",
            description: "Kruti Dev key mapping with on-screen guidance.",
            badge: "Beginner",
            accent: "secondary",
            key-sequence: "B M H C R A S N",
            meta-1: "8 Steps",
            meta-2: "Beginner + Classic",
            cta: "Start Learning",
        },
    ];
}
