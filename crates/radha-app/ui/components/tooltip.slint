// ============================================================================
// RadhaTooltip
// ============================================================================
//
// Hover-triggered label. Wraps the element it describes:
//
//   RadhaTooltip {
//       text: "Restart this exercise";
//       RadhaButton { text: "Restart"; }
//   }
//
// SIZING CAVEAT — read before using this in a tight layout
// --------------------------------------------------------
// The bubble is a child of this component, so it contributes to the component's
// implicit width even while hidden. A tooltip wrapping a 90px button but carrying
// a long message therefore measures as wide as the *message*, not the button.
//
// In a constrained horizontal layout that silently pushes neighbouring content out
// of view. It cannot be fixed by binding this component's width to `content` —
// that is the self-sizing-from-descendant cycle which collapses the element to
// zero. So: use this where there is slack, keep messages short, or give the
// instance an explicit width matching the wrapped control.
//
// Implementation note
// -------------------
// Rendered as an absolutely-positioned sibling rather than a `PopupWindow`.
// A PopupWindow is a real OS-level surface, which on the low-end Windows target
// means a visible creation cost on every hover — too heavy for something that
// appears and disappears as the pointer moves across a toolbar.
//
// The tradeoff: this cannot extend beyond the window bounds, so a tooltip on an
// element at the very edge of the window may be clipped. Acceptable for
// in-window toolbars, which is the only place Radha uses tooltips. Revisit if a
// tooltip is ever needed at a window edge.
// ============================================================================

import { Theme } from "../theme/palette.slint";
import { Typography } from "../theme/typography.slint";
import { Spacing, Radius, Elevation, Motion, Stroke } from "../theme/metrics.slint";

export enum TooltipSide {
    Above,
    Below,
}

export component RadhaTooltip {
    in property <string> text;
    in property <TooltipSide> side: TooltipSide.Above;
    // Suppress without restructuring the tree — useful in Focus Mode, which
    // reduces chrome (PRD.md Section 8.4).
    in property <bool> enabled: true;

    // Size is left to Slint, derived from the wrapped child. Binding width/height
    // to `content.preferred-*` here is the same self-sizing cycle that silently
    // collapsed the modal and toast to zero, so it is deliberately avoided.
    content := HorizontalLayout {
        @children
    }

    // Covers the child to detect hover. Placed after the content so it sits on
    // top, and non-blocking so the child still receives clicks.
    hover := TouchArea {
        width: 100%;
        height: 100%;
    }

    bubble := Rectangle {
        // `hover.has-hover` alone would leave the bubble mid-fade when disabled.
        property <bool> shown: root.enabled && hover.has-hover;

        visible: shown;
        // Size is left to Slint, computed from the padded label inside. Binding
        // width/height to `label.preferred-*` here would be a cycle (an element
        // sizing itself from its own descendant), which collapses the bubble to
        // zero and paints nothing.
        x: (root.width - self.width) / 2;
        y: root.side == TooltipSide.Above
            ? -self.height - Spacing.xs
            : root.height + Spacing.xs;

        background: Theme.secondary;
        border-radius: Radius.sm;
        border-width: Stroke.hairline;
        border-color: Theme.secondary-hover;
        drop-shadow-blur: Elevation.floating-blur;
        drop-shadow-offset-y: Elevation.floating-offset-y;
        drop-shadow-color: Theme.shadow.with-alpha(Elevation.floating-opacity);

        opacity: shown ? 1.0 : 0.0;
        animate opacity { duration: Motion.fast; }

        // A layout supplies the padding, so the bubble's computed size already
        // includes it.
        HorizontalLayout {
            padding-left: Spacing.md;
            padding-right: Spacing.md;
            padding-top: Spacing.sm;
            padding-bottom: Spacing.sm;

            label := Text {
                text: root.text;
                font-family: Typography.family-ui;
                font-size: Typography.size-caption;
                font-weight: Typography.weight-medium;
                // Cream on plum in both themes — the bubble is always a dark
                // surface, so it does not follow the theme's text colour.
                color: #FFFDF8;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
