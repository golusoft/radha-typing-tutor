// ============================================================================
// WelcomePanel — compact hero strip above the product sections (HOME-04)
// ============================================================================
//
// Deliberately NOT a marketing hero. Home is a training dashboard, and a large
// welcome block would push the actual products below the fold on a 768px-tall
// window — exactly the screen this product targets as its minimum.
//
// So: greeting + streak + Quick Resume, a 7D / 30D net-WPM sparkline, and
// three compact stats. Roughly 150px tall.
//
// Honest empty state
// ------------------
// Every figure comes from SQLite through `UtilityView` (P08), computed when
// Home is shown or a session is saved, never while typing. With no sessions
// the stats show an em dash, the sparkline its empty text, and no streak or
// resume line — never zeros or invented numbers.
// ============================================================================

import { Theme } from "../theme/palette.slint";
import { Typography } from "../theme/typography.slint";
import { Spacing, Radius, Stroke } from "../theme/metrics.slint";
import { SparklineChart } from "sparkline_chart.slint";
import { RadhaButton, ButtonVariant } from "button.slint";
import { UtilityView } from "../data/utility.slint";

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> accent: Theme.primary;

    spacing: 1px;
    alignment: center;

    Text {
        text: root.label;
        font-family: Typography.family-ui;
        font-size: Typography.size-micro;
        font-weight: Typography.weight-medium;
        letter-spacing: Typography.tracking-wide;
        color: Theme.text-tertiary;
    }

    Text {
        text: root.value;
        font-family: Typography.family-ui;
        font-size: Typography.size-h2;
        font-weight: Typography.weight-semibold;
        color: root.accent;
    }
}

export component WelcomePanel inherits Rectangle {
    /// `false` until real session history exists.
    in property <bool> has-data: false;

    in property <string> practice-time: "—";
    in property <string> best-wpm: "—";
    in property <string> accuracy: "—";

    background: Theme.primary-subtle;
    border-radius: Radius.lg;
    border-width: Stroke.hairline;
    border-color: Theme.border-soft;

    // --- Deterministic internal widths --------------------------------------
    // The greeting column contains a `wrap: word-wrap` Text. Slint sizes a layout
    // child by its PREFERRED width, and a wrapped Text reports its full unwrapped
    // line as that preferred width — so leaving the column to `horizontal-stretch`
    // makes the panel demand far more space than it has and push the page wider
    // than the window.
    //
    // Giving the column an explicit width is what forces the Text to wrap to fit
    // instead of reporting its unwrapped size upward. `width` on this panel is set
    // by the caller, so these values come from outside and cannot be influenced by
    // the content.
    private property <length> stats-width: 260px;
    private property <length> chart-width: 300px;
    private property <length> greeting-width:
        root.width - Spacing.xl * 4 - root.stats-width - root.chart-width;

    HorizontalLayout {
        padding: Spacing.lg;
        padding-left: Spacing.xl;
        padding-right: Spacing.xl;
        spacing: Spacing.xl;

        // --- Greeting, streak, Quick Resume -----------------------------------
        VerticalLayout {
            width: root.greeting-width;
            spacing: Spacing.xxs;
            alignment: center;

            Text {
                text: root.has-data ? "Welcome back" : "Welcome to Radha Typing Tutor";
                font-family: Typography.family-ui;
                font-size: Typography.size-h2;
                font-weight: Typography.weight-semibold;
                letter-spacing: Typography.tracking-tight;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                width: root.greeting-width;
                text: root.has-data
                    ? "Continue building speed, accuracy and consistency."
                    : "Pick a course below to begin building speed and accuracy.";
                font-family: Typography.family-ui;
                font-size: Typography.size-body-sm;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }

            // visible: rather than if: — Rust sets these before run() (Slint rule 3).
            Text {
                visible: UtilityView.hero-streak != "";
                height: self.visible ? Typography.size-caption * 1.5 : 0px;
                text: UtilityView.hero-streak;
                font-family: Typography.family-ui;
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Theme.accent;
            }

            Rectangle {
                visible: UtilityView.hero-resume != "";
                height: self.visible ? 32px : 0px;
                HorizontalLayout {
                    spacing: Spacing.sm;
                    alignment: start;
                    RadhaButton {
                        text: "Resume";
                        compact: true;
                        clicked => {
                            UtilityView.resume();
                        }
                    }

                    Text {
                        width: root.greeting-width - 90px;
                        text: UtilityView.hero-resume;
                        font-family: Typography.family-devanagari;
                        font-size: Typography.size-caption;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        // --- Trend (7D / 30D) ---------------------------------------------------
        SparklineChart {
            width: root.chart-width;
            title: "Net WPM trend";
            value-text: UtilityView.hero-chart-value;
            line-commands: UtilityView.hero-chart-line;
            area-commands: UtilityView.hero-chart-area;
            peak-x: UtilityView.hero-peak-x;
            peak-y: UtilityView.hero-peak-y;
            has-data: UtilityView.hero-chart-has-data;
            empty-text: "No sessions in this range yet";
            footer-left: UtilityView.hero-chart-footer;
            footer-right: UtilityView.hero-chart-trend;
            // Both footers on one line elided "4 practice days · 11 ses…"
            // in the 300 px hero chart.
            stacked-footer: true;
            chart-height: 32px;
            range: UtilityView.hero-range;
            range-requested(id) => {
                UtilityView.hero-range-selected(id);
            }
        }

        // --- Stats ----------------------------------------------------------
        HorizontalLayout {
            width: root.stats-width;
            spacing: Spacing.lg;
            alignment: end;

            Stat {
                label: "PRACTICE";
                value: root.practice-time;
                accent: root.has-data ? Theme.primary : Theme.text-disabled;
            }

            Stat {
                label: "BEST NET";
                value: root.best-wpm;
                accent: root.has-data ? Theme.accent : Theme.text-disabled;
            }

            Stat {
                label: "ACCURACY";
                value: root.accuracy;
                accent: root.has-data ? Theme.success : Theme.text-disabled;
            }
        }
    }
}
